# 游戏副本本体（861 MB，可从 Steam 原版重新复制，不进版本库）
game/

# 存档快照与原始资源备份（含个人存档，不进版本库）
profile/
backup/

# 日志与临时文件
*.log
*.tmp
__pycache__/
*.pyc

# 生成产物：预设剧本包（由 mods/tools/build_presets.py 重建，共 100+ 个）
mods/out/

# 生成产物：插件编译输出（源码在 probe_plugin/Plugin.cs、ai_probe/Plugin.cs）
probe_plugin/bin/
probe_plugin/obj/
ai_probe/bin/
ai_probe/obj/

# 分析用的超大类型转储（可由 tools/TypeDump 重新导出）
dump/api_boardgames.txt
dump/api_worm_client.txt

# 会话内的工作记忆
.workbuddy/

# 本地密钥（LLM API Key 等，绝不入库）
mods/ai/deepseek_key.txt
mods/ai/*_key.txt

# 观察者：每次覆盖写的当前待选文本（临时）
dump/llm/last_pending.txt

# 离线分析工具的编译产物
tools/*/bin/
tools/*/obj/

# 抓取中间产物
dump/tmp/

# 官方 PDF 原件（49MB，按需重下：docs/官方资源清单.md 里有一键命令）
docs/pdf/
# PDF 转文本的中间产物
dump/pdf_txt/
